rules_version = '2';

// Droid Runner leaderboard (js/leaderboard.js).
// Everything is locked down except the bare minimum, and every score must be consistent
// with the real time (server time) elapsed since its run started.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Run start: only the player themselves, and the server sets the timestamp.
    match /runs/{uid} {
      allow get: if signedIn(uid);
      allow list: if false;
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt == request.time;
      allow delete: if false;
    }

    // One entry per player (their best score). The top 10 is publicly readable.
    match /scores/{uid} {
      allow get: if true;
      allow list: if request.query.limit <= 10;

      function run() {
        return get(/databases/$(db)/documents/runs/$(uid)).data;
      }

      function valid() {
        let d = request.resource.data;
        let elapsed = request.time.toMillis() - run().startedAt.toMillis();
        return signedIn(uid)
          && d.keys().hasOnly(['name', 'score', 'createdAt', 'runStartedAt'])
          && d.name is string
          && d.name.matches('^[A-Z0-9]{3}$')
          && !d.name.matches('^(ASS|FCK|FUK|FUC|SEX|KKK|NAZ|NIG|CUM|DIC|COK|PUT|PNE|CAC|CUL|PIS)$')
          && d.score is int
          && d.score > 0
          && d.score <= 100000
          && d.createdAt == request.time
          && d.runStartedAt == run().startedAt
          && elapsed >= 3000
          && d.score <= elapsed / 1000 * 90 + 50;
      }

      allow create: if valid();
      allow update: if valid()
        && request.resource.data.score > resource.data.score
        && request.resource.data.runStartedAt != resource.data.runStartedAt;
      allow delete: if false;
    }

    // Anonymous visit counter (js/stats.js). Aggregate integers only, no personal data.
    // Writes may only add exactly +1, and only to today's document (UTC).
    function before() {
      return resource == null ? {} : resource.data;
    }
    function changed() {
      return request.resource.data.diff(before()).affectedKeys();
    }
    // A key is either untouched or incremented by exactly one (missing counts as 0).
    function untouchedOrPlusOne(k) {
      return !(k in changed()) || request.resource.data[k] == before().get(k, 0) + 1;
    }

    match /visits/{day} {
      allow get: if true;
      allow list, delete: if false;

      function isToday() {
        return day.matches('^[0-9]{8}$') && int(day) ==
          request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
      }

      // One page view = total + exactly one key from each dimension (language, device, source).
      allow create, update: if isToday()
        && request.resource.data.keys().hasOnly(
             ['total', 'es', 'en', 'mobile', 'desktop', 'direct', 'search', 'linkedin', 'github', 'other'])
        && changed().size() == 4
        && changed().hasAll(['total'])
        && changed().hasAny(['es', 'en'])
        && changed().hasAny(['mobile', 'desktop'])
        && changed().hasAny(['direct', 'search', 'linkedin', 'github', 'other'])
        && untouchedOrPlusOne('total')
        && untouchedOrPlusOne('es') && untouchedOrPlusOne('en')
        && untouchedOrPlusOne('mobile') && untouchedOrPlusOne('desktop')
        && untouchedOrPlusOne('direct') && untouchedOrPlusOne('search')
        && untouchedOrPlusOne('linkedin') && untouchedOrPlusOne('github') && untouchedOrPlusOne('other');
    }

    // All-time total, written in the same commit as the daily document.
    match /stats/all {
      allow get: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['total'])
        && request.resource.data.total == before().get('total', 0) + 1;
      allow list, delete: if false;
    }

    // Any other path: closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
